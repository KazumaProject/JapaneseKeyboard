+LITERTLM_JNIEXPORT jlong JNICALL JNI_METHOD(nativeCloneSessionForScoring)(
+    JNIEnv* env, jclass, jlong session_pointer) {
+  auto* session = reinterpret_cast<Engine::Session*>(session_pointer);
+  auto cloned = session->Clone();
+  if (!cloned.ok()) {
+    ThrowLiteRtLmJniException(env, cloned.status().ToString());
+    return 0;
+  }
+  return reinterpret_cast<jlong>(cloned->release());
+}
