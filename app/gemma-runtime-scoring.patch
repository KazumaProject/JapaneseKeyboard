+// The Kotlin scoring methods pass standard UTF-8 bytes, including supplementary characters.
+LITERTLM_JNIEXPORT jstring JNICALL JNI_METHOD(nativeRenderScoringPrompt)(
+    JNIEnv* env, jclass, jlong engine_pointer, jbyteArray prompt) {
+  auto* engine = reinterpret_cast<Engine*>(engine_pointer);
+  auto config = ConversationConfig::CreateDefault(*engine);
+  if (!config.ok()) {
+    ThrowLiteRtLmJniException(env, config.status().ToString());
+    return nullptr;
+  }
+  std::string text(env->GetArrayLength(prompt), '\0');
+  env->GetByteArrayRegion(prompt, 0, text.size(), reinterpret_cast<jbyte*>(text.data()));
+  if (env->ExceptionCheck()) return nullptr;
+  litert::lm::PromptTemplateInput input;
+  input.messages = nlohmann::ordered_json::array({{{"role", "user"}, {"content", text}}});
+  input.extra_context["enable_thinking"] = false;
+  auto rendered = config->GetPromptTemplate().Apply(input);
+  if (!rendered.ok()) {
+    ThrowLiteRtLmJniException(env, rendered.status().ToString());
+    return nullptr;
+  }
+  return NewStringStandardUTF(env, *rendered);
+}
