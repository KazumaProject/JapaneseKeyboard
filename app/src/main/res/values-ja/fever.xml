<resources>
    <string name="keyboard_skin_fever">FEVER</string>
    <string name="keyboard_skin_fever_description">ネオンのキーとコンボ。金と虹色の大当たり演出。</string>
    <string name="fever_settings_title">FEVER演出設定</string>
    <string name="fever_settings_summary">演出範囲・強さ・音・抽選率・反応語を設定します。</string>
    <string name="fever_preview">演出を試す</string>
    <string name="fever_preview_summary">プレビューをタップすると再生します。実際の入力やコンボ数には影響しません。</string>
    <string name="fever_full_screen">画面全体に演出</string>
    <string name="fever_full_screen_summary">OFF：キーボード内。ON：キーボード表示中、入力先の画面にも演出を広げます。</string>
    <string name="fever_intensity">演出の強さ</string>
    <string name="fever_intensity_summary">0：控えめ・1：標準・2：激アツ</string>
    <string name="fever_sound">専用の効果音</string>
    <string name="fever_vibration">専用の振動</string>
