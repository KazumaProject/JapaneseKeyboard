<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="candidate_rerank_current"
        android:selectable="false"
        android:title="@string/candidate_rerank_current_title"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="candidate_rerank_zenz_setup"
        android:summary="@string/candidate_rerank_zenz_setup_summary"
        android:title="@string/candidate_rerank_zenz_setup_title"
        app:iconSpaceReserved="false" />

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="candidate_rerank_custom_model"
        android:summary="@string/candidate_rerank_custom_summary"
        android:title="@string/candidate_rerank_custom_title">

        <Preference
            android:key="candidate_scoring_model"
            android:summary="@string/candidate_scoring_model_summary"
            android:title="@string/candidate_scoring_model"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="candidate_scoring_tokenizer"
            android:summary="@string/candidate_scoring_tokenizer_summary"
            android:title="@string/candidate_scoring_tokenizer"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="candidate_scoring_clear"
            android:title="@string/candidate_scoring_clear"
            app:iconSpaceReserved="false" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>
</PreferenceScreen>
