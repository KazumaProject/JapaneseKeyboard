<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/dictionary_browser_title">
        <Preference
            android:key="dictionary_browser_preference"
            android:title="@string/dictionary_browser_title"
            app:summary="@string/dictionary_browser_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/system_user_dictionary">

        <Preference
            android:key="system_user_dictionary_builder_preference"
            android:title="@string/system_user_dictionary_builder_title"
            app:summary="@string/system_user_dictionary_builder_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/external_dictionary_settings_title">

        <Preference
            android:key="external_dictionary_settings_preference"
            android:title="@string/external_dictionary_settings_title"
            app:summary="@string/external_dictionary_settings_summary" />

    </PreferenceCategory>

