        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_TERM"
            android:title="@string/classified_dictionary_term"
            android:defaultValue="true"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_WORK_FRANCHISE"
            android:title="@string/classified_dictionary_work_franchise"
            android:defaultValue="true"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_WORK_MANGA"
            android:title="@string/classified_dictionary_work_manga"
            android:defaultValue="true"
            android:persistent="false"
