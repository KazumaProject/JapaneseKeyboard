            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_AWARD"
            android:title="@string/classified_dictionary_award"
            android:defaultValue="true"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_AGREEMENT"
            android:title="@string/classified_dictionary_agreement"
            android:defaultValue="true"
