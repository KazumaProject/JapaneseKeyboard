            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_WORK_BOOK"
            android:title="@string/classified_dictionary_work_book"
            android:defaultValue="true"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_WORK_GAME"
            android:title="@string/classified_dictionary_work_game"
            android:defaultValue="true"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="optional_bundled_enabled_CLASSIFIED_WORK_MUSIC"
            android:title="@string/classified_dictionary_work_music"
            android:defaultValue="true"
            android:persistent="false"
            app:iconSpaceReserved="false" />

