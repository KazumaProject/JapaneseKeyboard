<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_conversion"
        android:title="@string/settings_engine_conversion_title"
        android:summary="@string/settings_engine_conversion_summary">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="incremental_conversion_session_preference"
            android:summaryOff="@string/incremental_conversion_session_summary_off"
            android:summaryOn="@string/incremental_conversion_session_summary_on"
            android:title="@string/incremental_conversion_session_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="english_floating_grammar_correction_preference"
            android:summary="@string/english_floating_correction_summary"
            android:title="@string/english_floating_correction_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="conversion_bunsetsu_separation_preference"
            android:title="@string/conversion_separation_title"
            app:summary="@string/conversion_separation_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="conversion_bunsetsu_separation_preference"
            android:key="conversion_bunsetsu_cursor_move_preference"
            android:title="@string/conversion_bunsetsu_cursor_move_title"
            app:summary="@string/conversion_bunsetsu_cursor_move_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="reconversion_preference"
            android:title="@string/reconversion_preference_title"
            app:summary="@string/reconversion_preference_summary" />

        <ListPreference
            android:defaultValue="deferred"
            android:dialogTitle="@string/delete_long_press_conversion_behavior_title"
            android:entries="@array/delete_long_press_conversion_behavior_entries"
            android:entryValues="@array/delete_long_press_conversion_behavior_values"
            android:key="delete_long_press_conversion_behavior"
            android:title="@string/delete_long_press_conversion_behavior_title"
            app:useSimpleSummaryProvider="true" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_live"
        android:title="@string/settings_engine_live_title"
        android:summary="@string/settings_engine_live_summary">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="live_conversion_preference"
            android:summaryOff="@string/live_conversion_summary_off"
            android:summaryOn="@string/live_conversion_summary_on"
            android:title="@string/live_conversion_title" />

        <SeekBarPreference
            android:defaultValue="1"
            android:dependency="live_conversion_preference"
            android:key="live_conversion_start_length_preference"
            android:max="10"
            android:summary="@string/live_conversion_start_length_summary"
            android:title="@string/live_conversion_start_length_title"
            app:min="1"
            app:showSeekBarValue="true" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_prediction"
        android:title="@string/settings_engine_prediction_title"
        android:summary="@string/settings_engine_prediction_summary">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="japanese_prediction_enable_preference"
            android:summary="@string/japanese_prediction_enable_summary"
            android:title="@string/japanese_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="english_prediction_enable_preference"
            android:summary="@string/english_prediction_enable_summary"
            android:title="@string/english_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:defaultValue="3"
            android:dependency="japanese_prediction_enable_preference"
            android:key="prediction_minimum_input_length_preference"
            android:max="8"
            android:summary="@string/prediction_minimum_input_length_summary"
            android:title="@string/prediction_minimum_input_length_title"
            app:min="3"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:defaultValue="4"
            android:key="system_prediction_candidate_limit_preference"
            android:max="16"
            android:summary="@string/system_prediction_candidate_limit_summary"
            android:title="@string/system_prediction_candidate_limit_title"
            app:min="1"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:defaultValue="3"
            android:dependency="japanese_prediction_enable_preference"
            android:key="prediction_lookahead_preference"
            android:max="6"
            android:summary="@string/prediction_lookahead_summary"
            android:title="@string/prediction_lookahead_title"
            app:min="1"
            app:showSeekBarValue="true" />

        <ListPreference
            android:defaultValue="standard"
            android:dependency="japanese_prediction_enable_preference"
            android:entries="@array/prediction_aggressiveness_entries"
            android:entryValues="@array/prediction_aggressiveness_values"
            android:key="prediction_aggressiveness_preference"
            android:title="@string/prediction_aggressiveness_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="zero_query_suggestion_preference"
            android:summaryOff="@string/zero_query_suggestion_summary_off"
            android:summaryOn="@string/zero_query_suggestion_summary_on"
            android:title="@string/zero_query_suggestion_title"
            app:iconSpaceReserved="false" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_dictionaries"
        android:title="@string/settings_engine_dictionaries_title"
        android:summary="@string/settings_engine_dictionaries_summary">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="english_reading_dictionary_enable_preference"
            android:summary="@string/english_reading_dictionary_enable_summary"
            android:title="@string/english_reading_dictionary_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="japanese_prediction_enable_preference"
            android:key="system_dictionary_prediction_enable_preference"
            android:summary="@string/system_dictionary_prediction_enable_summary"
            android:title="@string/system_dictionary_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="japanese_prediction_enable_preference"
            android:key="system_user_dictionary_prediction_enable_preference"
            android:summary="@string/system_user_dictionary_prediction_enable_summary"
            android:title="@string/system_user_dictionary_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="japanese_prediction_enable_preference"
            android:key="reading_correction_prediction_enable_preference"
            android:summary="@string/reading_correction_prediction_enable_summary"
            android:title="@string/reading_correction_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="japanese_prediction_enable_preference"
            android:key="proverb_prediction_enable_preference"
            android:summary="@string/proverb_prediction_enable_summary"
            android:title="@string/proverb_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="japanese_prediction_enable_preference"
            android:key="external_mozc_prediction_enable_preference"
            android:summary="@string/external_mozc_prediction_enable_summary"
            android:title="@string/external_mozc_prediction_enable_title"
            app:iconSpaceReserved="false" />


        <SwitchPreferenceCompat
            android:key="enable_prediction_search_learn_dictionary_preference"
            android:title="@string/enable_prediction_search_learn_dictionary_preference_titile"
            app:defaultValue="false"
            app:summary="@string/enable_prediction_search_learn_dictionary_preference_summary" />
        <SeekBarPreference
            android:defaultValue="4"
            android:dependency="enable_prediction_search_learn_dictionary_preference"
            android:key="learn_prediction_preference"
            android:max="8"
            android:title="@string/settings_learn_dictionary_prediction_start"
            app:min="1"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:defaultValue="4"
            android:dependency="enable_prediction_search_learn_dictionary_preference"
            android:key="learn_dictionary_prediction_candidate_limit_preference"
            android:max="8"
            android:summary="@string/learn_dictionary_prediction_candidate_limit_summary"
            android:title="@string/settings_learn_dictionary_prediction_limit"
            app:min="1"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:defaultValue="2"
            android:key="user_dictionary_prefix_match_number"
            android:max="8"
            android:title="@string/settings_user_dictionary_prediction_start"
            app:min="2"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:defaultValue="4"
            android:key="user_dictionary_prediction_candidate_limit_preference"
            android:max="8"
            android:summary="@string/user_dictionary_prediction_candidate_limit_summary"
            android:title="@string/settings_user_dictionary_prediction_limit"
            app:min="1"
            app:showSeekBarValue="true" />

        <Preference
            android:key="settings_engine_enable_learning_dictionary_link"
            android:title="@string/settings_engine_enable_learning_dictionary"
            android:summary="@string/settings_engine_enable_learning_dictionary_summary" />

        <Preference
            android:key="settings_engine_enable_user_dictionary_link"
            android:title="@string/settings_engine_enable_user_dictionary"
            android:summary="@string/settings_engine_enable_user_dictionary_summary" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_correction"
        android:title="@string/settings_engine_correction_title"
        android:summary="@string/settings_engine_correction_summary">

        <SwitchPreferenceCompat
            android:key="enable_typo_correction_japanese_flick_keyboard_preference"
            android:title="@string/enable_typo_correction_japanese_flick_keyboard_preference_title"
            app:defaultValue="false"
            app:summary="@string/enable_typo_correction_japanese_flick_keyboard_preference_sumary" />

        <SeekBarPreference
            android:key="enable_typo_correction_japanese_flick_keyboard_offset_score_preference"
            android:max="5000"
            android:title="@string/enable_typo_correction_japanese_flick_keyboard_offset_score_preference_tittle"
            app:defaultValue="3000"
            app:min="0"
            app:seekBarIncrement="10"
            app:showSeekBarValue="true"
            app:summary="@string/enable_typo_correction_japanese_flick_keyboard_offset_score_preference_summary" />

        <SwitchPreferenceCompat
            android:key="enable_typo_correction_qwerty_english_keyboard_preference"
            android:title="@string/enable_typo_correction_qwerty_english_keyboard_preference_title"
            app:defaultValue="false"
            app:summary="@string/enable_typo_correction_qwerty_english_keyboard_preference_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="omission_search_preference"
            android:summaryOff="@string/omission_search_summary_off"
            android:summaryOn="@string/omission_search_summary_on"
            android:title="@string/omission_search_title" />

        <SeekBarPreference
            android:key="omission_search_preference_offset_score_preference"
            android:max="5000"
            android:title="@string/omission_search_preference_offset_score_preference_title"
            app:defaultValue="1900"
            app:min="0"
            app:seekBarIncrement="10"
            app:showSeekBarValue="true"
            app:summary="@string/omission_search_preference_offset_score_preference_summary" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_candidates"
        android:title="@string/settings_engine_candidates_title"
        android:summary="@string/settings_engine_candidates_summary">

        <Preference
            android:key="date_candidate_settings_preference"
            android:title="@string/date_candidate_settings_title"
            android:summary="@string/date_candidate_settings_summary"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:dependency="japanese_prediction_enable_preference"
            android:key="symbol_emoji_prediction_enable_preference"
            android:summary="@string/symbol_emoji_prediction_enable_summary"
            android:title="@string/symbol_emoji_prediction_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="symbol_candidate_enable_preference"
            android:summary="@string/symbol_candidate_enable_summary"
            android:title="@string/symbol_candidate_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="emoji_candidate_enable_preference"
            android:summary="@string/emoji_candidate_enable_summary"
            android:title="@string/emoji_candidate_enable_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="emoticon_candidate_enable_preference"
            android:summary="@string/emoticon_candidate_enable_summary"
            android:title="@string/emoticon_candidate_enable_title"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="setting_route_utility_candidates"
            android:summary="@string/utility_candidate_settings_summary"
            android:title="@string/utility_candidate_settings_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="conversion_candidates_romaji_enable_preference"
            android:title="@string/conversion_candidates_romaji_enable_preference_title"
            app:defaultValue="false"
            app:summary="@string/conversion_candidates_romaji_enable_preference_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="conversion_key_long_press_ai_conversion_preference"
            android:summary="@string/conversion_key_long_press_ai_conversion_preference_summary"
            android:title="@string/conversion_key_long_press_ai_conversion_preference_title" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

    <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory
        android:key="settings_engine_search"
        android:title="@string/settings_engine_search_title"
        android:summary="@string/settings_engine_search_summary">

        <SeekBarPreference
            android:defaultValue="4"
            android:key="n_best_preference"
            android:max="16"
            android:summary="@string/n_best_preference_summary"
            android:title="N-Best"
            app:min="2"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:defaultValue="20"
            android:key="conversion_beam_width_preference"
            android:max="100"
            android:summary="@string/conversion_beam_width_preference_summary"
            android:title="@string/conversion_beam_width_preference_title"
            app:min="1"
            app:showSeekBarValue="true" />

    </com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.setting.CollapsiblePreferenceCategory>

</PreferenceScreen>
