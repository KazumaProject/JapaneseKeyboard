<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/suggestion_item_background"
    android:padding="12dp">
    <com.kazumaproject.markdownhelperkeyboard.ime_service.adapters.CandidateCharacterTextView
        android:id="@+id/text_view_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/keyboard_icon_color"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/floating_candidate_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/keyboard_icon_color"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
