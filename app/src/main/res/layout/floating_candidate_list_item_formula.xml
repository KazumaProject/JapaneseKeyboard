<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_formula_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/suggestion_item_background"
    android:gravity="center"
    android:minWidth="48dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="5dp">

    <com.kazumaproject.markdownhelperkeyboard.ime_service.adapters.FormulaView
        android:id="@+id/floating_formula_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/floating_formula_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/keyboard_icon_color"
        android:textSize="8sp" />

</LinearLayout>
